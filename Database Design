Database Design
-- =====================================================
-- Hotel Management Database
-- Database Design
-- SQL Server
-- =====================================================

CREATE DATABASE HotelManagementDB;
GO

USE HotelManagementDB;
GO


-- =====================================================
-- 1. Hotels
-- =====================================================

CREATE TABLE Hotels (
    HotelID INT PRIMARY KEY,
    HotelName VARCHAR(100) NOT NULL,
    City VARCHAR(100) NOT NULL,
    Country VARCHAR(100) NOT NULL,
    StarRating INT,
    OpeningDate DATE
);


-- =====================================================
-- 2. Room Types
-- =====================================================

CREATE TABLE RoomTypes (
    RoomTypeID INT PRIMARY KEY,
    HotelID INT NOT NULL,
    TypeName VARCHAR(100) NOT NULL,
    BasePrice DECIMAL(10,2) NOT NULL,
    MaxOccupancy INT NOT NULL,

    CONSTRAINT FK_RoomTypes_Hotels
        FOREIGN KEY (HotelID)
        REFERENCES Hotels(HotelID)
);


-- =====================================================
-- 3. Rooms
-- =====================================================

CREATE TABLE Rooms (
    RoomID INT PRIMARY KEY,
    HotelID INT NOT NULL,
    RoomTypeID INT NOT NULL,
    RoomNumber VARCHAR(20) NOT NULL,
    Floor INT,
    Status VARCHAR(30) NOT NULL,

    CONSTRAINT FK_Rooms_Hotels
        FOREIGN KEY (HotelID)
        REFERENCES Hotels(HotelID),

    CONSTRAINT FK_Rooms_RoomTypes
        FOREIGN KEY (RoomTypeID)
        REFERENCES RoomTypes(RoomTypeID)
);


-- =====================================================
-- 4. Guests
-- =====================================================

CREATE TABLE Guests (
    GuestID INT PRIMARY KEY,
    FirstName VARCHAR(50) NOT NULL,
    LastName VARCHAR(50) NOT NULL,
    Email VARCHAR(100),
    Phone VARCHAR(30),
    Nationality VARCHAR(50),
    DOB DATE,
    LoyaltyTier VARCHAR(30),
    JoinDate DATE
);


-- =====================================================
-- 5. Employees
-- =====================================================

CREATE TABLE Employees (
    EmployeeID INT PRIMARY KEY,
    HotelID INT NOT NULL,
    ManagerID INT NULL,
    FirstName VARCHAR(50) NOT NULL,
    LastName VARCHAR(50) NOT NULL,
    JobRole VARCHAR(100),
    HireDate DATE,
    Salary DECIMAL(12,2),

    CONSTRAINT FK_Employees_Hotels
        FOREIGN KEY (HotelID)
        REFERENCES Hotels(HotelID),

    CONSTRAINT FK_Employees_Manager
        FOREIGN KEY (ManagerID)
        REFERENCES Employees(EmployeeID)
);


-- =====================================================
-- 6. Bookings
-- =====================================================

CREATE TABLE Bookings (
    BookingID INT PRIMARY KEY,
    GuestID INT NOT NULL,
    RoomID INT NOT NULL,
    CreatedBy INT,
    BookingDate DATE NOT NULL,
    CheckInDate DATE NOT NULL,
    CheckOutDate DATE NOT NULL,
    Status VARCHAR(30) NOT NULL,
    Channel VARCHAR(50),

    CONSTRAINT FK_Bookings_Guests
        FOREIGN KEY (GuestID)
        REFERENCES Guests(GuestID),

    CONSTRAINT FK_Bookings_Rooms
        FOREIGN KEY (RoomID)
        REFERENCES Rooms(RoomID),

    CONSTRAINT FK_Bookings_Employees
        FOREIGN KEY (CreatedBy)
        REFERENCES Employees(EmployeeID)
);


-- =====================================================
-- 7. Payments
-- =====================================================

CREATE TABLE Payments (
    PaymentID INT PRIMARY KEY,
    BookingID INT NOT NULL,
    PaymentDate DATE,
    Amount DECIMAL(12,2) NOT NULL,
    Method VARCHAR(50),
    Status VARCHAR(30),

    CONSTRAINT FK_Payments_Bookings
        FOREIGN KEY (BookingID)
        REFERENCES Bookings(BookingID)
);


-- =====================================================
-- 8. Services
-- =====================================================

CREATE TABLE Services (
    ServiceID INT PRIMARY KEY,
    HotelID INT NOT NULL,
    ServiceName VARCHAR(100) NOT NULL,
    Price DECIMAL(10,2) NOT NULL,

    CONSTRAINT FK_Services_Hotels
        FOREIGN KEY (HotelID)
        REFERENCES Hotels(HotelID)
);


-- =====================================================
-- 9. Booking Services
-- =====================================================

CREATE TABLE BookingServices (
    BookingID INT NOT NULL,
    ServiceID INT NOT NULL,
    Quantity INT NOT NULL,

    PRIMARY KEY (BookingID, ServiceID),

    CONSTRAINT FK_BookingServices_Bookings
        FOREIGN KEY (BookingID)
        REFERENCES Bookings(BookingID),

    CONSTRAINT FK_BookingServices_Services
        FOREIGN KEY (ServiceID)
        REFERENCES Services(ServiceID)
);


-- =====================================================
-- 10. Reviews
-- =====================================================

CREATE TABLE Reviews (
    ReviewID INT PRIMARY KEY,
    BookingID INT NOT NULL UNIQUE,
    Rating INT,
    Comment VARCHAR(1000),
    ReviewDate DATE,

    CONSTRAINT FK_Reviews_Bookings
        FOREIGN KEY (BookingID)
        REFERENCES Bookings(BookingID)
);
